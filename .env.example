# Gemini provider for the commentary server: "direct" (GEMINI_API_KEY),
# "proxy" (CLIproxy: CLIPROXY_BASE_URL + CLIPROXY_API_KEY), or "auto"
# (default: direct if GEMINI_API_KEY is set, else proxy if the CLIPROXY
# vars are set, else no client). An invalid value refuses at startup.
GEMINI_PROVIDER=auto
GEMINI_API_KEY=
PORT=3000

# --- CLIproxy option (provider=proxy) ---
# The values live in .env.private/clients.env.sh (not committed). Bun auto-loads
# .env; for the CLIproxy vars, source the file before starting the server:
#   set -a; source .env.private/clients.env.sh; set +a; bun run dev
# CLIPROXY_BASE_URL=http://127.0.0.1:8317/v1
# CLIPROXY_API_KEY=
