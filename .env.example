# Gemini provider for the commentary server: "direct" (GEMINI_API_KEY, optionally
# through a gateway via GOOGLE_GEMINI_BASE_URL), "proxy" (CLIproxy: CLIPROXY_BASE_URL
# + CLIPROXY_API_KEY), or "auto" (default: direct if GEMINI_API_KEY is set, else
# proxy if the CLIPROXY vars are set, else no client). An invalid value refuses at
# startup.
GEMINI_PROVIDER=auto
GEMINI_API_KEY=
# Optional gateway for the native Gemini dialect (e.g. CLIproxy). Values live in
# .env.private/clients.env.sh (not committed) — Bun auto-loads .env; for the
# others, source the file before starting the server:
#   set -a; source .env.private/clients.env.sh; set +a; bun run dev
# GOOGLE_GEMINI_BASE_URL=http://127.0.0.1:8317/v1
PORT=3000

# --- CLIproxy option (provider=proxy) ---
# CLIPROXY_BASE_URL=http://127.0.0.1:8317
# CLIPROXY_API_KEY=
